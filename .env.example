# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is ignored by git, so your values stay on your computer.
# On Netlify, add the same names under Project configuration > Environment variables.

# Required. OAuth client ID of type "Web application" from Google Cloud
# (Google Auth Platform > Clients). It ends in .apps.googleusercontent.com.
# It is a public identifier, not a password. NEVER put a client secret
# (it starts with GOCSPX-) or a service-account key here.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Required. The long ID from your sheet's address:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
VITE_SPREADSHEET_ID=your-spreadsheet-id

# Optional. The Google account that owns the sheet, e.g. you@gmail.com.
# Google pre-selects it when you click Connect. Note: whatever you put here
# is built into the site's code, which anyone who opens the site can read.
VITE_GOOGLE_ACCOUNT_HINT=
